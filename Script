-- Settings: Farben (Buttons = ALLE TextButtons im GUI außer Close & aktive ON-Toggles)
local function applyAccentColor(color)
	COL_ACCENT = color
	timerOverlayStroke.Color = color
	pcall(function() saveWinsBtn.BackgroundColor3 = color end)
	pcall(function() discordBtn.BackgroundColor3 = color end)
	pcall(function() openPickerBtn.BackgroundColor3 = color end)
	if currentTab and tabs[currentTab] then
		tabs[currentTab].button.BackgroundColor3 = color
	end
	rFill.BackgroundColor3 = color
	gFill.BackgroundColor3 = color
	bFill.BackgroundColor3 = color
	dFill.BackgroundColor3 = color
	if applyTarget == "accent" then
		tAccent.BackgroundColor3 = color
	end
end

local DEFAULT_ACCENT = Color3.fromRGB(100, 80, 220)
local DEFAULT_BTN = Color3.fromRGB(35, 35, 48)
local DEFAULT_BTN_HOVER = Color3.fromRGB(48, 48, 65)
local DEFAULT_PANEL = Color3.fromRGB(18, 18, 24)
local DEFAULT_ON = Color3.fromRGB(0, 140, 80)

local function isToggleOnButton(btn)
	local t = btn.Text or ""
	return t:find(": AN") ~= nil
end

local function shouldSkipTheme(btn)
	if not btn or not btn:IsA("TextButton") then return true end
	if btn == closeButton or btn == pickerClose then return true end
	if btn:GetAttribute("NoTheme") then return true end
	if isToggleOnButton(btn) then return true end
	if currentTab and tabs[currentTab] and btn == tabs[currentTab].button then return true end
	-- Color picker interne Buttons (Ziel-Auswahl, Übernehmen)
	if btn:IsDescendantOf(pickerFrame) then return true end
	return false
end

local function applyBtnColor(color)
	COL_BTN = color
	COL_BTN_HOVER = Color3.new(
		math.clamp(color.R * 1.25, 0, 1),
		math.clamp(color.G * 1.25, 0, 1),
		math.clamp(color.B * 1.25, 0, 1)
	)
	local function paint(btn)
		if shouldSkipTheme(btn) then return end
		btn.BackgroundColor3 = color
	end
	for _, d in ipairs(mainFrame:GetDescendants()) do
		paint(d)
	end
	-- Tabs inaktiv
	for name, data in pairs(tabs) do
		if name ~= currentTab then
			data.button.BackgroundColor3 = color
		end
	end
end

local function applyFrameColor(color)
	COL_PANEL = color
	mainFrame.BackgroundColor3 = color
	local titleC = Color3.new(
		math.clamp(color.R * 1.2, 0, 1),
		math.clamp(color.G * 1.2, 0, 1),
		math.clamp(color.B * 1.2, 0, 1)
	)
	titleBar.BackgroundColor3 = titleC
	titleFix.BackgroundColor3 = titleC
	sidebar.BackgroundColor3 = Color3.new(
		math.clamp(color.R * 0.85, 0, 1),
		math.clamp(color.G * 0.85, 0, 1),
		math.clamp(color.B * 0.85, 0, 1)
	)
	pickerFrame.BackgroundColor3 = color
	confirmFrame.BackgroundColor3 = color
end

local function resetAllColors()
	COL_ACCENT = DEFAULT_ACCENT
	COL_BTN = DEFAULT_BTN
	COL_BTN_HOVER = DEFAULT_BTN_HOVER
	COL_PANEL = DEFAULT_PANEL
	COL_ON = DEFAULT_ON
	applyAccentColor(DEFAULT_ACCENT)
	applyBtnColor(DEFAULT_BTN)
	applyFrameColor(DEFAULT_PANEL)
	print("[MonkeyGUI] Farben zurückgesetzt")
end

for _, entry in ipairs(accentColorBtns) do
