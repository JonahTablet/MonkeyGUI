local speedRunOn = false
local timerRunning = false
local timerStart = 0
local currentWorld = nil
local recordW1 = nil
local srConns = {}
local endFolder = nil

local function fmt(t)
	return string.format("%.2f", t)
end

local function clearSR()
	for _, c in ipairs(srConns) do
		pcall(function() c:Disconnect() end)
	end
	srConns = {}
	if endFolder then
		pcall(function() endFolder:Destroy() end)
		endFolder = nil
	end
end

local function resetTimer()
	timerRunning = false
	timerStart = 0
	currentWorld = nil
	timerOverlay.Text = "0.00"
	srStatus.Text = "Status: Bereit (Start beruehren)"
end

local function hookTouch(obj, cb)
	local function attach(p)
		if p:IsA("BasePart") then
			table.insert(srConns, p.Touched:Connect(function(hit)
				local char = player.Character
				if char and hit and hit:IsDescendantOf(char) then
					cb()
				end
			end))
		end
	end
	if obj:IsA("BasePart") then
		attach(obj)
	else
		for _, d in ipairs(obj:GetDescendants()) do
			attach(d)
		end
	end
end

local function setupSR()
	clearSR()
	endFolder = Instance.new("Folder")
	endFolder.Name = "MonkeyGUI_CH2_Ends"
	endFolder.Parent = workspace
	local p = Instance.new("Part")
	p.Name = "CH2_World1End"
	p.Anchored = true
	p.CanCollide = false
	p.Transparency = 1
	p.Size = CFG.END_W1.s
	p.Position = CFG.END_W1.p
	p.Parent = endFolder
	hookTouch(p, function()
		if not speedRunOn or not timerRunning then return end
		if currentWorld ~= 1 then return end
		timerRunning = false
		local elapsed = tick() - timerStart
		timerOverlay.Text = fmt(elapsed)
		if not recordW1 or elapsed < recordW1 then
			recordW1 = elapsed
			srStatus.Text = "Status: Rekord! " .. fmt(elapsed) .. "s"
		else
			srStatus.Text = "Status: Fertig " .. fmt(elapsed) .. "s"
		end
	end)
	local map = workspace:FindFirstChild("Map")
	local world = map and map:FindFirstChild("World1")
	local stages = world and world:FindFirstChild("Stages")
	local spawn = stages and stages:FindFirstChild("Spawn")
	local wall = spawn and spawn:FindFirstChild("StageWall")
	if wall then
		hookTouch(wall, function()
			if not speedRunOn or timerRunning then return end
			currentWorld = 1
			timerStart = tick()
			timerRunning = true
			srStatus.Text = "Status: Laeuft - World 1"
		end)
	end
end

RunService.RenderStepped:Connect(function()
	if speedRunOn and timerRunning and timerStart > 0 then
		timerOverlay.Text = fmt(tick() - timerStart)
	end
end)

srBtn.MouseButton1Click:Connect(function()
