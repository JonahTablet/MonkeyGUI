		clearSR()
		srStatus.Text = "Status: Aus"
	end
end)

-- Leaks: only New Tails in W5
local tailsBtn, tailsSt = makeToggle(leaksPage, "New Tails in W5: AUS", 1)
local TAILS_Y = 23.790407180786133
local tailsOn = false
local tailsConn = nil

local function applyTailsY()
	local map = workspace:FindFirstChild("Map")
	local w5 = map and map:FindFirstChild("World5")
	local upgrades = w5 and w5:FindFirstChild("Upgrades")
	if not upgrades then return end
	for _, obj in ipairs(upgrades:GetChildren()) do
		if obj:IsA("Model") then
			pcall(function()
				local pivot = obj:GetPivot()
				local pos = pivot.Position
				obj:PivotTo(CFrame.new(pos.X, TAILS_Y, pos.Z) * (pivot - pivot.Position))
			end)
		elseif obj:IsA("BasePart") then
			obj.CFrame = CFrame.new(obj.Position.X, TAILS_Y, obj.Position.Z) * (obj.CFrame - obj.Position)
		end
	end
end

tailsBtn.MouseButton1Click:Connect(function()
	if not ALIVE() then return end
	tailsOn = not tailsOn
	setToggle(tailsBtn, tailsSt, tailsOn, "New Tails in W5: AN", "New Tails in W5: AUS")
	if tailsOn then
		if tailsConn then tailsConn:Disconnect() end
		tailsConn = RunService.Heartbeat:Connect(function()
			if not ALIVE() or not tailsOn then return end
			applyTailsY()
		end)
	else
		if tailsConn then tailsConn:Disconnect() tailsConn = nil end
	end
end)

