local function makeToggle(parent, text, order)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, CFG.BTN_H)
	btn.BackgroundColor3 = CFG.COL_BTN
	btn.BorderSizePixel = 0
	btn.Text = text
	btn.TextColor3 = CFG.COL_TEXT
	btn.TextSize = 12
	btn.Font = Enum.Font.GothamBold
	btn.AutoButtonColor = false
	btn.LayoutOrder = order
	btn.Parent = parent
	corner(btn, 7)
	local st = stroke(btn)
	return btn, st
end

local function setToggle(btn, st, on, onT, offT)
	btn.Text = on and onT or offT
	btn.BackgroundColor3 = on and CFG.COL_ON or CFG.COL_BTN
	if st then
		st.Color = on and Color3.fromRGB(80, 220, 140) or CFG.COL_STROKE
	end
end

local function tpTo(pos)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.CFrame = CFrame.new(pos)
	end
end

local function setInv(part, store)
	if not part then return end
	local function apply(o)
		if o:IsA("BasePart") then
			if not store[o] then
				store[o] = {CanCollide = o.CanCollide, Transparency = o.Transparency}
			end
			o.CanCollide = false
			o.Transparency = 1
		end
	end
	if part:IsA("BasePart") then
		apply(part)
	elseif part:IsA("Model") then
		for _, d in ipairs(part:GetDescendants()) do
			apply(d)
		end
	end
end

local function restore(part, store)
	if not part then return end
	local function rest(o)
		if o:IsA("BasePart") and store[o] then
			o.CanCollide = store[o].CanCollide
			o.Transparency = store[o].Transparency
			store[o] = nil
		end
	end
	if part:IsA("BasePart") then
		rest(part)
	elseif part:IsA("Model") then
		for _, d in ipairs(part:GetDescendants()) do
			rest(d)
		end
	end
end

-- Chapter 2 World1 farm
local function makeWorld(page, label, order, winName)
	local btn, st = makeToggle(page, label .. ": AUS", order)
	local on, conn, store, partRef = false, nil, {}, nil
	local function getPart()
		local map = workspace:FindFirstChild("Map")
		local world = map and map:FindFirstChild("World1")
		local stages = world and world:FindFirstChild("Stages")
		local stage = stages and stages:FindFirstChild("Stage4")
		local stageEnd = stage and stage:FindFirstChild("StageEnd")
		local win = stageEnd and stageEnd:FindFirstChild(winName)
		if not win then return nil end
		return win:FindFirstChild("Button") or win
	end
	btn.MouseButton1Click:Connect(function()
		if not ALIVE() then return end
		on = not on
		setToggle(btn, st, on, label .. ": AN", label .. ": AUS")
		if on then
			tpTo(CFG.TP_W1)
			if conn then conn:Disconnect() end
			conn = RunService.Heartbeat:Connect(function()
				if not ALIVE() or not on then return end
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if not hrp then return end
				local part = getPart()
				if part then
					partRef = part
					setInv(part, store)
					if part:IsA("Model") then
						part:PivotTo(hrp.CFrame)
					elseif part:IsA("BasePart") then
						part.CFrame = hrp.CFrame
					end
				end
			end)
		else
			if conn then conn:Disconnect() conn = nil end
			restore(partRef or getPart(), store)
			partRef = nil
		end
	end)
	return function()
		on = false
		if conn then pcall(function() conn:Disconnect() end) conn = nil end
		restore(partRef or getPart(), store)
		setToggle(btn, st, false, label .. ": AN", label .. ": AUS")
	end
end

