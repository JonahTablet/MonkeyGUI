local function createWorldToggle(config)
	local state = {on = false, connection = nil, part = nil, original = {}}
	local function getPart()
		local map = workspace:FindFirstChild("Map")
		if not map then return nil end
		local world = map:FindFirstChild(config.worldName)
		if not world then return nil end
		local stages = world:FindFirstChild("Stages")
		if not stages then return nil end
		local stage = stages:FindFirstChild(config.stageName)
		if not stage then return nil end
		local container = stage
		if config.useFinalDestination then
			container = stage:FindFirstChild("FinalDestination")
			if not container then return nil end
		end
		local winFolder = container:FindFirstChild(config.winName)
		if not winFolder then return nil end
		return winFolder:FindFirstChild("Button")
	end
	local function toggle()
		state.on = not state.on
		setButtonState(config.button, config.stroke, state.on, config.name .. ": AN", config.name .. ": AUS")
		if state.on then
			local character = player.Character
			if character then
				local hrp = character:FindFirstChild("HumanoidRootPart")
				if hrp then hrp.CFrame = CFrame.new(config.position) end
			end
			state.part = getPart()
			setPartInvisible(state.part, state.original)
			state.connection = RunService.Heartbeat:Connect(function()
				local character = player.Character
				if not character then return end
				local hrp = character:FindFirstChild("HumanoidRootPart")
				if not hrp then return end
				local part = getPart()
				if part then
					state.part = part
					setPartInvisible(part, state.original)
					if part:IsA("Model") then part:PivotTo(hrp.CFrame) else part.CFrame = hrp.CFrame end
				end
			end)
		else
			if state.connection then state.connection:Disconnect() state.connection = nil end
			restorePart(state.part or getPart(), state.original)
			state.part = nil
		end
	end
	config.button.MouseButton1Click:Connect(toggle)
	return state
end

