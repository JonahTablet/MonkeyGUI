	setButtonState(speedFarmBtn, speedFarmStroke, speedFarmOn, "Speed Farm: AN", "Speed Farm: AUS")
	if speedFarmOn then
		speedFarmThread = task.spawn(function()
			while speedFarmOn do
				doForwardStep()
				if not speedFarmOn then break end
				task.wait(STAND_TIME)
			end
		end)
	else
		if speedFarmThread then
			task.cancel(speedFarmThread)
			speedFarmThread = nil
		end
		local _, humanoid = getCharacterParts()
		if humanoid then humanoid:Move(Vector3.zero) end
	end
end
