local function clamp255(n)
	n = tonumber(n) or 0
	return math.clamp(math.floor(n + 0.5), 0, 255)
end

local function getPickerColor()
	local r = clamp255(rBox.Text)
	local g = clamp255(gBox.Text)
	local b = clamp255(bBox.Text)
	local d = math.clamp(tonumber(dBox.Text) or 100, 0, 100) / 100
	rBox.Text = tostring(r)
	gBox.Text = tostring(g)
	bBox.Text = tostring(b)
	dBox.Text = tostring(math.floor(d * 100 + 0.5))
	rFill.Size = UDim2.new(r / 255, 0, 1, 0)
	gFill.Size = UDim2.new(g / 255, 0, 1, 0)
	bFill.Size = UDim2.new(b / 255, 0, 1, 0)
	dFill.Size = UDim2.new(d, 0, 1, 0)
	local color = Color3.fromRGB(r * d, g * d, b * d)
	previewBox.BackgroundColor3 = color
	return color
end

local function bindBar(barBg, box, isDark)
	barBg.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local conn
		local function update(pos)
			local rel = math.clamp((pos.X - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
			if isDark then
				box.Text = tostring(math.floor(rel * 100 + 0.5))
			else
				box.Text = tostring(math.floor(rel * 255 + 0.5))
			end
			getPickerColor()
		end
		update(input.Position)
		conn = UserInputService.InputChanged:Connect(function(inp)
			if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
				update(inp.Position)
			end
		end)
		local endConn
		endConn = UserInputService.InputEnded:Connect(function(inp)
			if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
				if conn then conn:Disconnect() end
				if endConn then endConn:Disconnect() end
			end
		end)
	end)
	box.FocusLost:Connect(function()
		getPickerColor()
	end)
end

