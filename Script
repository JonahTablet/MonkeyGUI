local function tpTo(pos)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then hrp.CFrame = CFrame.new(pos) end
end

local function setInv(part, store)
	if not part then return end
	local function apply(o)
		if o:IsA("BasePart") then
			if not store[o] then store[o] = {CanCollide=o.CanCollide, Transparency=o.Transparency} end
			o.CanCollide = false
			o.Transparency = 1
		end
	end
	if part:IsA("BasePart") then apply(part)
	elseif part:IsA("Model") then for _,d in ipairs(part:GetDescendants()) do apply(d) end end
end

local function restore(part, store)
	if not part then return end
	local function rest(o)
		if o:IsA("BasePart") and store[o] then
			o.CanCollide = store[o].CanCollide
			o.Transparency = store[o].Transparency
			store[o] = nil
		end
	end
	if part:IsA("BasePart") then rest(part)
	elseif part:IsA("Model") then for _,d in ipairs(part:GetDescendants()) do rest(d) end end
end

local function makeWorld(page, label, order, worldName, stageName, winName, pos, useFinal)
	local btn, st = makeToggle(page, label..": AUS", order)
	local on, conn, store, partRef = false, nil, {}, nil
	local function getPart()
		local map = workspace:FindFirstChild("Map")
		if not map then return nil end
		local world = map:FindFirstChild(worldName)
		if not world then return nil end
		local stages = world:FindFirstChild("Stages")
		if not stages then return nil end
		local stage = stages:FindFirstChild(stageName)
		if not stage then return nil end
		if useFinal then
			local fd = stage:FindFirstChild("FinalDestination")
			stage = fd or stage
		end
		local win = stage:FindFirstChild(winName)
		if not win then return nil end
		return win:FindFirstChild("Button") or win
	end
	btn.MouseButton1Click:Connect(function()
		on = not on
		setToggle(btn, st, on, label..": AN", label..": AUS")
		if on then
			tpTo(pos)
			if conn then conn:Disconnect() end
			conn = RunService.Heartbeat:Connect(function()
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if not hrp then return end
				local part = getPart()
				if part then
					partRef = part
					setInv(part, store)
					if part:IsA("Model") then
						part:PivotTo(hrp.CFrame)
					elseif part:IsA("BasePart") then
						part.CFrame = hrp.CFrame
					end
				end
			end)
		else
			if conn then conn:Disconnect() conn = nil end
			restore(partRef or getPart(), store)
			partRef = nil
		end
	end)
end

