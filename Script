local function formatTime(t)
	return string.format("%.2f", t)
end

local function updateRecordLabels()
	for i = 1, 5 do
		if records[i] then
			recordLabels[i].Text = "World " .. i .. ":  " .. formatTime(records[i]) .. "s"
			recordLabels[i].TextColor3 = Color3.fromRGB(120, 255, 160)
		else
			recordLabels[i].Text = "World " .. i .. ":  --.--"
			recordLabels[i].TextColor3 = COL_TEXT
		end
	end
end

local function setTimerDisplay(t)
	timerOverlay.Text = formatTime(t)
end

local function stopTimer(finished)
	timerRunning = false
	if finished and currentWorld and timerStart > 0 then
		local elapsed = tick() - timerStart
		setTimerDisplay(elapsed)
		if not records[currentWorld] or elapsed < records[currentWorld] then
			records[currentWorld] = elapsed
			updateRecordLabels()
			timerStatusLabel.Text = "Status: Rekord! World " .. currentWorld
			timerStatusLabel.TextColor3 = Color3.fromRGB(120, 255, 160)
		else
			timerStatusLabel.Text = "Status: Fertig World " .. currentWorld
			timerStatusLabel.TextColor3 = COL_MUTED
		end
	end
end

local function resetTimerIdle()
	timerRunning = false
	timerStart = 0
	currentWorld = nil
	setTimerDisplay(0)
	timerStatusLabel.Text = "Status: Bereit (Start berühren)"
	timerStatusLabel.TextColor3 = COL_MUTED
end

local function startTimer(worldIndex)
	if not speedRunOn then return end
	if timerRunning then return end
	currentWorld = worldIndex
	timerStart = tick()
	timerRunning = true
	timerStatusLabel.Text = "Status: Läuft – World " .. worldIndex
	timerStatusLabel.TextColor3 = Color3.fromRGB(255, 200, 80)
end

local function isPlayerTouch(hit)
	if not hit then return false end
	local char = player.Character
	if not char then return false end
	return hit:IsDescendantOf(char)
end

local function connectTouchesOn(obj, callback)
	if not obj then return end
	local function hook(part)
		if part:IsA("BasePart") then
			table.insert(speedRunConnections, part.Touched:Connect(function(hit)
				if isPlayerTouch(hit) then
					callback()
				end
			end))
		end
	end
	if obj:IsA("BasePart") then
		hook(obj)
	else
		for _, d in ipairs(obj:GetDescendants()) do
			hook(d)
		end
		for _, c in ipairs(obj:GetChildren()) do
			hook(c)
		end
	end
end

local function createEndParts()
	if endPartsFolder and endPartsFolder.Parent then
		endPartsFolder:Destroy()
	end
	endPartsFolder = Instance.new("Folder")
	endPartsFolder.Name = "MonkeyGUI_SpeedRunEnds"
	endPartsFolder.Parent = workspace

	for i, data in ipairs(END_PART_DATA) do
		local p = Instance.new("Part")
		p.Name = data.name
		p.Anchored = true
		p.CanCollide = false
		p.Transparency = 1
		p.Size = data.size
		p.Position = data.pos
		p.Parent = endPartsFolder
		connectTouchesOn(p, function()
			if not speedRunOn or not timerRunning then return end
			if currentWorld ~= i then return end
			stopTimer(true)
		end)
	end
end

local function connectStartWalls()
	local map = workspace:FindFirstChild("Map")
	if not map then return end
	for i = 1, 5 do
		local world = map:FindFirstChild("World" .. i)
		if world then
			local stages = world:FindFirstChild("Stages")
			local spawn = stages and stages:FindFirstChild("Spawn")
			local wall = spawn and spawn:FindFirstChild("StageWall")
			if wall then
				local worldIndex = i
				connectTouchesOn(wall, function()
					if not speedRunOn or timerRunning then return end
					startTimer(worldIndex)
				end)
			end
		end
	end
end

local function clearSpeedRunConnections()
	for _, c in ipairs(speedRunConnections) do
		pcall(function() c:Disconnect() end)
	end
	speedRunConnections = {}
	if endPartsFolder then
		pcall(function() endPartsFolder:Destroy() end)
		endPartsFolder = nil
	end
end

-- Nur Timer-Anzeige (kein Proximity)
RunService.RenderStepped:Connect(function()
	if speedRunOn and timerRunning and timerStart > 0 then
		setTimerDisplay(tick() - timerStart)
	end
end)

local function hookDeath(char)
	local humanoid = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
	if humanoid then
		humanoid.Died:Connect(function()
			if speedRunOn then
				resetTimerIdle()
				setTimerDisplay(0)
			end
		end)
	end
end

if player.Character then hookDeath(player.Character) end
player.CharacterAdded:Connect(function(char)
	task.wait(0.2)
	hookDeath(char)
	if speedRunOn then
		resetTimerIdle()
		setTimerDisplay(0)
	end
end)

local function toggleSpeedRun()
	speedRunOn = not speedRunOn
	setButtonState(speedRunBtn, speedRunStroke, speedRunOn, "Speed Run: AN", "Speed Run: AUS")
	if speedRunOn then
		timerOverlay.Visible = true
		resetTimerIdle()
		clearSpeedRunConnections()
		createEndParts()
		connectStartWalls()
		print("[MonkeyGUI] Speed Run aktiv")
	else
		timerOverlay.Visible = false
		timerRunning = false
		clearSpeedRunConnections()
		setTimerDisplay(0)
		timerStatusLabel.Text = "Status: Aus"
		timerStatusLabel.TextColor3 = COL_MUTED
		print("[MonkeyGUI] Speed Run deaktiviert")
	end
end

speedRunBtn.MouseButton1Click:Connect(toggleSpeedRun)

