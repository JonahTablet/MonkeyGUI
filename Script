	local function hook(p)
		if p:IsA("BasePart") then
			table.insert(srConns, p.Touched:Connect(function(hit)
				if isTouch(hit) then cb() end
			end))
		end
	end
	if obj:IsA("BasePart") then hook(obj)
	else for _,d in ipairs(obj:GetDescendants()) do hook(d) end end
end

local function setupSR()
	clearSR()
	endFolder = Instance.new("Folder")
	endFolder.Name = "MonkeyGUI_SpeedRunEnds"
	endFolder.Parent = workspace
	for i,d in ipairs(CFG.ENDS) do
		local p = Instance.new("Part")
		p.Name = d.n; p.Anchored = true; p.CanCollide = false; p.Transparency = 1
		p.Size = d.s; p.Position = d.p; p.Parent = endFolder
		local wi = i
		hookTouch(p, function()
			if not State.speedRunOn or not State.timerRunning then return end
			if State.currentWorld ~= wi then return end
			State.timerRunning = false
			local elapsed = tick() - State.timerStart
			timerOverlay.Text = fmt(elapsed)
			if not records[wi] or elapsed < records[wi] then
				records[wi] = elapsed; updateRecords()
				srStatus.Text = "Status: Rekord! World "..wi
			else
				srStatus.Text = "Status: Fertig World "..wi
			end
		end)
	end
	local map = workspace:FindFirstChild("Map")
	if not map then return end
	for i=1,5 do
		local world = map:FindFirstChild("World"..i)
		local stages = world and world:FindFirstChild("Stages")
		local spawn = stages and stages:FindFirstChild("Spawn")
		local wall = spawn and spawn:FindFirstChild("StageWall")
		local wi = i
		if wall then
			hookTouch(wall, function()
				if not State.speedRunOn or State.timerRunning then return end
				State.currentWorld = wi
				State.timerStart = tick()
				State.timerRunning = true
				srStatus.Text = "Status: Laeuft - World "..wi
			end)
		end
	end
end

