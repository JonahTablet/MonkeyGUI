local speedThread = nil
local function toggleSpeed()
	State.speedOn = not State.speedOn
	setToggle(speedBtn, speedSt, State.speedOn, "Speed Boost: AN", "Speed Boost: AUS")
	if State.speedOn then
		speedThread = task.spawn(function()
			while State.speedOn do
				task.wait(0)
				if levelValue then levelValue.Value = 1000 end
			end
		end)
	else
		if speedThread then task.cancel(speedThread) speedThread = nil end
		if levelValue and leaderLevel then levelValue.Value = leaderLevel.Value end
	end
end
