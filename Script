local function setPartInvisible(part, storage)
	if not part then return end
	local function apply(obj)
		if obj:IsA("BasePart") then
			if not storage[obj] then
				storage[obj] = {CanCollide = obj.CanCollide, Transparency = obj.Transparency}
			end
			obj.CanCollide = false
			obj.Transparency = 1
		end
	end
	if part:IsA("BasePart") then apply(part)
	elseif part:IsA("Model") then
		for _, d in ipairs(part:GetDescendants()) do apply(d) end
	end
end

local function restorePart(part, storage)
	if not part then return end
	local function restore(obj)
		if obj:IsA("BasePart") and storage[obj] then
			obj.CanCollide = storage[obj].CanCollide
			obj.Transparency = storage[obj].Transparency
			storage[obj] = nil
		end
	end
	if part:IsA("BasePart") then restore(part)
	elseif part:IsA("Model") then
		for _, d in ipairs(part:GetDescendants()) do restore(d) end
	end
end

